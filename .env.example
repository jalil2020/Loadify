# ─── App ────────────────────────────────────────────────────────────
APP_NAME=Loadify
APP_ENV=development                # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Tashkent
APP_DEFAULT_LOCALE=uz

# ─── PostgreSQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=loadify
DB_PASSWORD=loadify_secret
DB_NAME=loadify
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=loadify

# ─── Security ───────────────────────────────────────────────────────
BCRYPT_COST=12
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# ─── S3 / MinIO ─────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=loadify
S3_SECRET_KEY=loadify_secret
S3_BUCKET=loadify
S3_REGION=us-east-1
S3_USE_SSL=false

# ─── SMS (OTP) ──────────────────────────────────────────────────────
SMS_PROVIDER=log                   # log | eskiz | playmobile
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_SENDER=4546

# ─── Firebase Cloud Messaging ───────────────────────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# ─── Google Maps ────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Payments ───────────────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=5
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# ─── Frontend (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Telegram distribution ──────────────────────────────────────────
# Register the app at my.telegram.org; the terms require your own credentials.
# Leave all three empty to run without posting: the worker starts and idles.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# base64 of 32 random bytes: openssl rand -base64 32
# Wraps every stored session. Losing it makes every connected account unusable;
# leaking it makes every connected account readable.
TELEGRAM_SESSION_KEK=
TELEGRAM_SESSION_KEK_VERSION=1
# During a rotation, keep the previous key here until every row is resealed.
TELEGRAM_SESSION_KEK_PREVIOUS=
TELEGRAM_SESSION_KEK_PREVIOUS_VERSION=
TELEGRAM_DEVICE_MODEL=Loadify
TELEGRAM_APP_VERSION=1.0

# Platform ceilings. Telegram publishes no numbers for user accounts, so these
# are our own conservative policy. A tariff or a group rule may lower them.
TELEGRAM_ACCOUNT_GAP=90s
TELEGRAM_ACCOUNT_HOURLY=20
TELEGRAM_ACCOUNT_DAILY=120
TELEGRAM_GROUP_COOLDOWN=1h
TELEGRAM_GROUP_DAILY=3
TELEGRAM_DUPLICATE_WINDOW=24h
TELEGRAM_GLOBAL_PER_SECOND=10
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_LEASE_TTL=2m

# ─── AI helpers (optional) ──────────────────────────────────────────
# none | llm | hermes. Parsing falls back to the rules and ranking to the
# score, so "none" is a complete product, not a broken one.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20s
AI_CACHE_TTL=24h
HERMES_BASE_URL=
HERMES_API_KEY=
