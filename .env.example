# ─── App ────────────────────────────────────────────────────────────
APP_NAME=Loadify
APP_ENV=development                # development | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Tashkent
APP_DEFAULT_LOCALE=uz

# ─── PostgreSQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=loadify
DB_PASSWORD=loadify_secret
DB_NAME=loadify
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=loadify

# ─── Security ───────────────────────────────────────────────────────
BCRYPT_COST=12
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m

# ─── S3 / MinIO ─────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=loadify
S3_SECRET_KEY=loadify_secret
S3_BUCKET=loadify
S3_REGION=us-east-1
S3_USE_SSL=false

# ─── SMS (OTP) ──────────────────────────────────────────────────────
SMS_PROVIDER=log                   # log | eskiz | playmobile
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_SENDER=4546

# ─── Firebase Cloud Messaging ───────────────────────────────────────
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# ─── Google Maps ────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Payments ───────────────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=5
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# ─── Frontend (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1/ws
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
