<?xml version="1.0" encoding="utf-8"?>
<!--
  English is the base locale. Reference data — region names, vehicle type
  labels, cargo types — is deliberately absent: the server localises those for
  the request's Accept-Language, so translating them again here would guarantee
  the two drift apart.
-->
