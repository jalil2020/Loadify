<?xml version="1.0" encoding="utf-8"?>
<!--
  The Loadify mark: an L carrying a package, opening into a forward arrow.
  Drawn inside the central 72x72 of the 108x108 adaptive viewport, so a
  launcher's mask can crop the outer ring without touching it.

  The wordmark and the motion lines from the full logo are deliberately absent —
  at 48dp they collapse into noise, and what survives at that size is the
  silhouette. ic_brand_mark.xml keeps them for use inside the app.

  Geometry is kept in step with the generator that produces the pre-API-26
  bitmaps; the two must agree or the icon changes shape across Android versions.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The L: down the left, then right along the bottom. -->
    <path
        android:fillColor="#1E56C9"
        android:pathData="M41.76,28.08 L49.68,28.08 L49.68,58.32 L64.08,58.32 L64.08,72.72 L35.28,72.72 L35.28,34.56 A6.48,6.48 0 0 1 41.76,28.08 Z" />

    <!-- The forward arrow, picking up where the bottom bar ends. -->
    <path
        android:fillColor="#2FAE4F"
        android:pathData="M61.2,51.84 L84.24,65.52 L61.2,79.2 Z" />

    <!-- The package, over the corner of the L. Its white outline is what keeps
         it from merging into the L, which is the same blue. -->
    <path
        android:fillColor="#1E56C9"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineJoin="round"
        android:pathData="M50.76,30.96 L70.2,30.96 A2.52,2.52 0 0 1 72.72,33.48 L72.72,50.04 A2.52,2.52 0 0 1 70.2,52.56 L50.76,52.56 A2.52,2.52 0 0 1 48.24,50.04 L48.24,33.48 A2.52,2.52 0 0 1 50.76,30.96 Z" />

    <!-- Lid seam and tab: what reads as "box" rather than "square". -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.3"
        android:pathData="M48.24,37.44 L72.72,37.44" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.3"
        android:pathData="M60.48,30.96 L60.48,37.44" />
</vector>
